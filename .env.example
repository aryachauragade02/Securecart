# Copy to .env to override the demo defaults in docker-compose.yml. Never commit .env.
POSTGRES_PASSWORD=securecart
DATA_ENCRYPTION_KEY=          # openssl rand -base64 32
SEED_ADMIN_PASSWORD=          # password for admin@securecart.test and support@securecart.test
TESTPAY_SECRET_KEY=
TESTPAY_WEBHOOK_SECRET=

# Optional: real Razorpay test mode instead of the TestPay sandbox
PAYMENT_PROVIDER=testpay      # or razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Where to send telemetry (PulseOps). Default: PulseOps running on this machine.
PULSEOPS_URL=http://host.docker.internal:8000
